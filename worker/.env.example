# --- Notion ---
# Dev PAT / integration token with Workers + Notion API capability, shared into the ✨ AI Skills DB
# and body pages. LOCAL (CLI/dry-run) reads NOTION_TOKEN below.
# DEPLOYED worker: the "NOTION_" prefix is reserved by the platform, so set the secret as
# SKILLS_NOTION_TOKEN instead:  ntn workers env set SKILLS_NOTION_TOKEN=<token>
# (config.ts reads SKILLS_NOTION_TOKEN first, then falls back to NOTION_TOKEN for local use.)
NOTION_TOKEN=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# API version that supports the Markdown endpoints (do not lower this).
NOTION_VERSION=2026-03-11
# API base URL. The ✨ AI Skills DB is in the DEV workspace, so this must be the DEV API base,
# not prod api.notion.com. Set to whatever NOTION_ENV=dev resolves to for your account.
NOTION_API_BASE_URL=https://api.notion.com
# The ✨ AI Skills data source (collection) id.
AI_SKILLS_DATASOURCE=<your-ai-skills-data-source-id>

# --- GitHub ---
# Fine-grained PAT scoped to ONLY this repo. Permissions: Contents R/W, Metadata R, Issues R/W.
# >>> PASTE YOUR PAT HERE for local dev. For the deployed worker run:
#     ntn workers env set GITHUB_TOKEN=<your-pat>
GITHUB_TOKEN=github_pat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GITHUB_REPO=<owner>/<repo>
GITHUB_BRANCH=main
# Commit identity used for sync-originated commits (must match what the Action ignores).
SYNC_BOT_NAME=skills-sync[bot]
SYNC_BOT_EMAIL=skills-sync@users.noreply.github.com

# --- Behavior ---
# What to do when GitHub deletes text that has open Notion comments: flag | salvage | allow
COMMENT_DELETE_POLICY=flag
